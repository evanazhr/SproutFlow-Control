# Mode: pakai .env.local.example (local) atau .env.online.example (HiveMQ Cloud).
# File ini hanya referensi; jalankan `pnpm env:local` / `pnpm env:online` untuk membuat .env.
# URL backend Express.js
VITE_API_URL=http://localhost:4000

# URL MQTT broker via WebSocket
VITE_MQTT_URL=ws://localhost:9001
VITE_MQTT_USERNAME=viewer
VITE_MQTT_PASSWORD=
VITE_MQTT_TOPIC_PREFIX=plant

# Perangkat yang dipantau (v1 satu perangkat)
VITE_DEVICE_ID=plant-001
