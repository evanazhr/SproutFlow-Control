# ============================================================
# MODE ONLINE — Supabase (via backend) + HiveMQ Cloud
# Cara pakai: cp .env.online.example .env, lalu isi semua <...>
#
# PENTING: semua VITE_* ikut ter-embed di bundle browser. Pakai akun `viewer`
# yang subscribe-only. JANGAN pakai credential backend di sini.
# Setelah ubah .env, jalankan ulang `pnpm build` / `pnpm deploy`.
# ============================================================
VITE_API_URL=https://api.evanazhar.my.id
VITE_MQTT_URL=wss://<cluster-id>.hivemq.cloud:8884/mqtt
VITE_MQTT_USERNAME=<viewer-user>
VITE_MQTT_PASSWORD=<viewer-password>
VITE_MQTT_TOPIC_PREFIX=plant
VITE_DEVICE_ID=plant-001
